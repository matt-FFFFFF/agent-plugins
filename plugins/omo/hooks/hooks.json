{
  "description": "One-time SessionStart notice recommending CodeGraph/caveman/comment-checker if missing, plus a PostToolUse guard that blocks AI-slop comments via comment-checker",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/comment-checker.sh\""
          }
        ]
      }
    ]
  }
}
